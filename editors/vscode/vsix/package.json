{
  "name": "ruby-fast-lsp",
  "displayName": "Ruby Fast LSP",
  "description": "High-performance Ruby Language Server with fast code navigation, syntax highlighting, and intelligent code insights for Ruby developers",
  "version": "0.2.6",
  "publisher": "naveenraj",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajnaveen344/ruby-fast-lsp"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets",
    "Language Packs"
  ],
  "keywords": [
    "ruby",
    "lsp",
    "language-server",
    "intellisense",
    "code-navigation",
    "productivity",
    "development"
  ],
  "activationEvents": [
    "onLanguage:ruby",
    "onLanguage:erb"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ruby",
        "aliases": [
          "Ruby",
          "ruby"
        ],
        "extensions": [
          ".rb",
          ".builder",
          ".eye",
          ".fcgi",
          ".gemspec",
          ".god",
          ".irbrc",
          ".jbuilder",
          ".mspec",
          ".pluginspec",
          ".podspec",
          ".prawn",
          ".pryrc",
          ".rabl",
          ".rake",
          ".rbi",
          ".rbuild",
          ".rbw",
          ".rbx",
          ".ru",
          ".ruby",
          ".spec",
          ".thor",
          ".watchr"
        ],
        "filenames": [
          ".irbrc",
          ".pryrc",
          ".simplecov",
          "Appraisals",
          "Berksfile",
          "Brewfile",
          "Buildfile",
          "Capfile",
          "Dangerfile",
          "Deliverfile",
          "Fastfile",
          "Gemfile",
          "Guardfile",
          "Jarfile",
          "Mavenfile",
          "Podfile",
          "Puppetfile",
          "Rakefile",
          "Snapfile",
          "Steepfile",
          "Thorfile",
          "Vagrantfile"
        ]
      },
      {
        "id": "erb",
        "aliases": [
          "ERB",
          "erb"
        ],
        "extensions": [
          ".erb",
          ".rhtml",
          ".rhtm"
        ]
      }
    ],
    "configuration": {
      "title": "Ruby Fast LSP",
      "properties": {
        "rubyFastLsp.logLevel": {
          "type": "string",
          "enum": ["info", "debug", "trace"],
          "default": "info",
          "description": "Log level for the LSP server output.",
          "enumDescriptions": [
            "Normal operation - indexing progress and errors only (recommended)",
            "Troubleshooting - feature diagnostics, cache operations, timing",
            "Development - per-node operations, very verbose (not for normal use)"
          ]
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "rubyIndex",
          "name": "Ruby Index",
          "visibility": "visible",
          "icon": "$(module)"
        }
      ]
    },
    "commands": [
      {
        "command": "rubyIndex.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "rubyIndex.export",
        "title": "Export Index as JSON",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rubyIndex.search",
        "title": "Search Classes/Modules",
        "icon": "$(search)"
      },
      {
        "command": "rubyIndex.toggleExternalTypes",
        "title": "Toggle External Types",
        "icon": "$(library)"
      },
      {
        "command": "ruby-fast-lsp.rspec.run",
        "title": "Run RSpec"
      },
      {
        "command": "ruby-fast-lsp.rspec.debug",
        "title": "Debug RSpec"
      },
      {
        "command": "ruby-fast-lsp.minitest.run",
        "title": "Run Minitest"
      },
      {
        "command": "ruby-fast-lsp.minitest.debug",
        "title": "Debug Minitest"
      },
      {
        "command": "ruby-fast-lsp.rails.openView",
        "title": "Open Rails View"
      },
      {
        "command": "ruby-fast-lsp.runtime.select",
        "title": "Ruby Fast LSP: Select Runtime"
      },
      {
        "command": "ruby-fast-lsp.runtime.status",
        "title": "Ruby Fast LSP: Show Runtime Status"
      },
      {
        "command": "ruby-fast-lsp.runtime.configure",
        "title": "Ruby Fast LSP: Configure Active Project"
      },
      {
        "command": "ruby-fast-lsp.linter.select",
        "title": "Ruby Fast LSP: Select Linter"
      },
      {
        "command": "ruby-fast-lsp.formatter.select",
        "title": "Ruby Fast LSP: Select Formatter"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rubyIndex.search",
          "when": "view == rubyIndex",
          "group": "navigation"
        },
        {
          "command": "rubyIndex.toggleExternalTypes",
          "when": "view == rubyIndex",
          "group": "navigation"
        },
        {
          "command": "rubyIndex.refresh",
          "when": "view == rubyIndex",
          "group": "navigation"
        },
        {
          "command": "rubyIndex.export",
          "when": "view == rubyIndex",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rubyIndex.search",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "view.rubyIndex.visible"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
