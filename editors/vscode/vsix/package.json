{
  "name": "ruby-fast-lsp",
  "displayName": "Ruby Fast LSP",
  "description": "High-performance Ruby Language Server with fast code navigation, syntax highlighting, and intelligent code insights for Ruby developers",
  "version": "0.2.6",
  "publisher": "naveenraj",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajnaveen344/ruby-fast-lsp"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets",
    "Language Packs"
  ],
  "keywords": [
    "ruby",
    "lsp",
    "language-server",
    "intellisense",
    "code-navigation",
    "productivity",
    "development"
  ],
  "activationEvents": [
    "onLanguage:ruby",
    "onLanguage:erb"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ruby",
        "aliases": [
          "Ruby",
          "ruby"
        ],
        "extensions": [
          ".rb",
          ".builder",
          ".eye",
          ".fcgi",
          ".gemspec",
          ".god",
          ".irbrc",
          ".jbuilder",
          ".mspec",
          ".pluginspec",
          ".podspec",
          ".prawn",
          ".pryrc",
          ".rabl",
          ".rake",
          ".rbi",
          ".rbuild",
          ".rbw",
          ".rbx",
          ".ru",
          ".ruby",
          ".spec",
          ".thor",
          ".watchr"
        ],
        "filenames": [
          ".irbrc",
          ".pryrc",
          ".simplecov",
          "Appraisals",
          "Berksfile",
          "Brewfile",
          "Buildfile",
          "Capfile",
          "Dangerfile",
          "Deliverfile",
          "Fastfile",
          "Gemfile",
          "Guardfile",
          "Jarfile",
          "Mavenfile",
          "Podfile",
          "Puppetfile",
          "Rakefile",
          "Snapfile",
          "Steepfile",
          "Thorfile",
          "Vagrantfile"
        ]
      },
      {
        "id": "erb",
        "aliases": [
          "ERB",
          "erb"
        ],
        "extensions": [
          ".erb",
          ".rhtml",
          ".rhtm"
        ]
      }
    ],
    "configuration": {
      "title": "Ruby Fast LSP",
      "properties": {
        "rubyFastLsp.rubyVersion": {
          "type": "string",
          "enum": [
            "auto",
            "1.9",
            "2.0",
            "2.1",
            "2.2",
            "2.3",
            "2.4",
            "2.5",
            "2.6",
            "2.7",
            "3.0",
            "3.1",
            "3.2",
            "3.3",
            "3.4"
          ],
          "default": "auto",
          "description": "Ruby version to use for core class stubs and language features. 'auto' will detect the version from your workspace (.ruby-version, Gemfile, etc.) or system Ruby installation.",
          "enumDescriptions": [
            "Automatically detect Ruby version from workspace or system",
            "Ruby 1.9.x",
            "Ruby 2.0.x",
            "Ruby 2.1.x",
            "Ruby 2.2.x",
            "Ruby 2.3.x",
            "Ruby 2.4.x",
            "Ruby 2.5.x",
            "Ruby 2.6.x",
            "Ruby 2.7.x",
            "Ruby 3.0.x",
            "Ruby 3.1.x",
            "Ruby 3.2.x",
            "Ruby 3.3.x",
            "Ruby 3.4.x"
          ]
        },
        "rubyFastLsp.stubsPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to Ruby stubs directory. Leave empty to use bundled stubs."
        },
        "rubyFastLsp.logLevel": {
          "type": "string",
          "enum": ["info", "debug", "trace"],
          "default": "info",
          "description": "Log level for the LSP server output.",
          "enumDescriptions": [
            "Normal operation - indexing progress and errors only (recommended)",
            "Troubleshooting - feature diagnostics, cache operations, timing",
            "Development - per-node operations, very verbose (not for normal use)"
          ]
        },
        "rubyFastLsp.linter": {
          "type": "string",
          "enum": ["none", "rubocop", "standard"],
          "default": "none",
          "description": "Run RuboCop or Standard diagnostics when a Ruby document is opened or saved. External linters never run while typing."
        },
        "rubyFastLsp.linterCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional linter command and arguments as an argv array, for example [\"bin/rubocop\"]. Empty uses bundle exec rubocop or bundle exec standardrb."
        },
        "rubyFastLsp.formatter": {
          "type": "string",
          "enum": ["none", "rubocop", "standard"],
          "default": "none",
          "description": "Format complete Ruby documents with safe RuboCop autocorrection or Standard formatting."
        },
        "rubyFastLsp.formatterCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional formatter command and arguments as an argv array, for example [\"bin/standardrb\"]. Empty uses bundle exec rubocop or bundle exec standardrb."
        },
        "rubyFastLsp.projectExtensionsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Discover manifest-based Wasm extensions inside trusted workspaces under .ruby-fast-lsp/extensions and ruby_fast_lsp. Project extensions never load in Restricted Mode."
        },
        "rubyFastLsp.extensionSettings": {
          "type": "object",
          "default": {},
          "additionalProperties": true,
          "description": "Per-extension settings keyed by extension manifest id. Values are delivered through bounded extension lifecycle events."
        },
        "rubyFastLsp.indexing": {
          "type": "object",
          "default": {
            "excludedPatterns": [],
            "includedPatterns": [],
            "excludedGems": [],
            "includedGems": [],
            "projectRoots": []
          },
          "properties": {
            "projectRoots": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "Optional workspace-relative Ruby project roots. Use this to split an umbrella workspace explicitly; roots must exist, remain inside the workspace, and must not overlap."
            },
            "excludedPatterns": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "Workspace-relative glob patterns to exclude from indexing. Exclusions override explicit includes and the default project-source policy."
            },
            "includedPatterns": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "Workspace-relative glob patterns that add nonstandard sources or explicitly opt files into default-external trees such as vendor."
            },
            "excludedGems": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "Gem names to omit even when directly or transitively required."
            },
            "includedGems": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "Gem names to index in addition to dependencies inferred from project source."
            }
          },
          "description": "Control project source and dependency indexing. Changing this setting restarts the language server to rebuild semantic state."
        },
        "rubyFastLsp.showExternalTypes": {
          "type": "boolean",
          "default": false,
          "description": "Show external types (core Ruby, stdlib, gems) in the Ruby Index tree. When disabled, only project-defined classes and modules are shown."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "rubyIndex",
          "name": "Ruby Index",
          "visibility": "visible",
          "icon": "$(module)"
        }
      ]
    },
    "commands": [
      {
        "command": "rubyIndex.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "rubyIndex.export",
        "title": "Export Index as JSON",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rubyIndex.search",
        "title": "Search Classes/Modules",
        "icon": "$(search)"
      },
      {
        "command": "rubyIndex.toggleExternalTypes",
        "title": "Toggle External Types",
        "icon": "$(library)"
      },
      {
        "command": "ruby-fast-lsp.rspec.run",
        "title": "Run RSpec"
      },
      {
        "command": "ruby-fast-lsp.rspec.debug",
        "title": "Debug RSpec"
      },
      {
        "command": "ruby-fast-lsp.minitest.run",
        "title": "Run Minitest"
      },
      {
        "command": "ruby-fast-lsp.minitest.debug",
        "title": "Debug Minitest"
      },
      {
        "command": "ruby-fast-lsp.rails.openView",
        "title": "Open Rails View"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rubyIndex.search",
          "when": "view == rubyIndex",
          "group": "navigation"
        },
        {
          "command": "rubyIndex.toggleExternalTypes",
          "when": "view == rubyIndex",
          "group": "navigation"
        },
        {
          "command": "rubyIndex.refresh",
          "when": "view == rubyIndex",
          "group": "navigation"
        },
        {
          "command": "rubyIndex.export",
          "when": "view == rubyIndex",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rubyIndex.search",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "view.rubyIndex.visible"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
