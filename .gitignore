/target
**/*.rs.bk
.idea/
.claude/
.vscode/
CLAUDE.md
*.swp
*.swo
.DS_Store
# DHAT heap profiling output
*heap.json
# Pre-zipped stubs (generated from editors/vscode/vsix/stubs, not tracked in git)
editors/vscode/vsix/stubs-zipped/
# npm platform binaries (built by CI)
editors/npm/darwin-arm64/bin/
editors/npm/darwin-x64/bin/
editors/npm/linux-x64/bin/
editors/npm/win32-x64/bin/
# Packaged core RBS copies (generated from crates/rbs-parser/rbs_types/core)
editors/npm/*/core-rbs/
editors/vscode/vsix/core-rbs/
# Packaged extension copies (staged from extensions/ by stage_package_assets.js)
editors/npm/*/extensions/

# Local automation configuration and Python bytecode
.codex/
__pycache__/
*.py[cod]
